<!DOCTYPE html><html lang="pt"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>D-MFINIX Fashion Market</title><style>body{margin:0;font-family:Arial;background:#080808;color:#fff;padding:8px}h1{color:#ff0055;text-align:center;margin:5px}.sub{color:#888;text-align:center;font-size:11px;margin-bottom:10px}.box{background:#151515;padding:12px;border-radius:14px;max-width:480px;margin:10px auto;border:1px solid #222}label{font-size:11px;color:#00ff88;font-weight:bold;display:block;margin-top:8px}input,select{width:100%;padding:11px;margin:4px 0;border-radius:8px;border:none;background:#222;color:#fff;box-sizing:border-box}button{background:#ff0055;color:#fff;border:none;padding:13px;border-radius:10px;font-weight:900;width:100%;margin-top:8px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.card{background:#1e1e1e;border-radius:10px;padding:6px;text-align:center;border:1px solid #333}.card img{width:100%;height:110px;object-fit:cover;border-radius:8px;background:#222}.preco{color:#00ff88;font-weight:900;font-size:13px}.preco2{color:#aaa;font-size:10px}.zap{background:#25D366;color:#fff;padding:12px;border-radius:10px;display:block;text-align:center;font-weight:900;text-decoration:none;margin-top:10px}</style></head><body><h1>D-MFINIX FASHION</h1><div class="sub">Marketplace - Vende Todo Tipo de Roupa | RAND + METICAL | Tembisa/Maputo</div><div class="box"><h3 style="color:#00ff88;margin:0 0 8px">➕ CADASTRAR ROUPA PRA VENDER</h3><label>Nome da Roupa:</label><input id="nome" placeholder="Ex: Camiseta Preta Street"><label>Categoria:</label><select id="cat"><option value="camiseta">👕 Camiseta</option><option value="calca">👖 Calça</option><option value="vestido">👗 Vestido</option><option value="tenis">👟 Tênis/Sapato</option><option value="crianca">👶 Criança</option><option value="casaco">🧥 Casaco</option><option value="intima">🩲 Roupa Íntima</option></select><label>Preço em RAND (R):</label><input id="precoR" type="number" placeholder="Ex: 80"><label>Foto (link ou deixa vazio):</label><input id="foto" placeholder="Cole link da imagem"><button onclick="cadastrar()">✅ CADASTRAR E COLOCAR NA LOJA</button><div class="grid" id="lista"></div><a class="zap" href="https://wa.me/27655594282">📲 CONTATO DANNY: 065 559 4282</a></div><script>let produtos=JSON.parse(localStorage.getItem('fashion_roubas')||'[]');if(produtos.length==0){produtos=[{nome:"Camiseta Street Preta",cat:"camiseta",precoR:80,img:"https://via.placeholder.com/300?text=Camiseta"},{nome:"Calça Jeans",cat:"calca",precoR:150,img:"https://via.placeholder.com/300?text=Calca"},{nome:"Vestido Verão",cat:"vestido",precoR:120,img:"https://via.placeholder.com/300?text=Vestido"}];}function cadastrar(){let n=document.getElementById('nome').value.trim(),c=document.getElementById('cat').value,p=parseFloat(document.getElementById('precoR').value),f=document.getElementById('foto').value||'https://via.placeholder.com/300?text='+encodeURIComponent(n);if(!n||!p){alert('⚠️ Escreve nome e preço!');return;}produtos.unshift({nome:n,cat:c,precoR:p,img:f});localStorage.setItem('fashion_roubas',JSON.stringify(produtos));mostrar();document.getElementById('nome').value='';document.getElementById('precoR').value='';document.getElementById('foto').value='';alert('✅ Roupa cadastrada na loja!');}function mostrar(){let cambio=3.6;let html='';produtos.forEach(pr=>{let m=(pr.precoR*cambio).toFixed(0);html+=`<div class="card"><img src="${pr.img}"><div style="font-size:11px;margin:4px 0">${pr.nome}</div><div class="preco">R ${pr.precoR}</div><div class="preco2">${m} MZN</div><a href="https://wa.me/27655594282?text=Olá%20quero%20${encodeURIComponent(pr.nome)}%20R${pr.precoR}%20%28${m}%20MZN%29" style="background:#25D366;color:#fff;padding:6px;border-radius:6px;display:block;text-decoration:none;margin-top:5px;font-size:10px;font-weight:900">COMPRAR NO ZAP</a></div>`});document.getElementById('lista').innerHTML=html;}mostrar();</script></body></html>